# Public source allowlist. Everything else stays local by default.
/*
!/.gitignore
!/Cargo.toml
!/Cargo.lock
!/rustfmt.toml
!/README.md
!/LICENSE
!/crates/
/crates/**
!/crates/**/
!/crates/**/*.rs
!/crates/**/Cargo.toml
!/crates/lrsim/tests/fixtures/empty_manifold.json

# Small rewrite-owned runtime configuration, never original game assets.
!/assets/
/assets/*
!/assets/native/
/assets/native/*
!/assets/native/audio.json
!/assets/native/builder.json
!/assets/native/hud.json
!/assets/native/powerups.json
!/assets/native/rules.json
!/assets/shaders/
/assets/shaders/*
!/assets/shaders/original_surface.wgsl

# Additional protection for binaries, originals, personal files and secrets.
*.iso
*.exe
*.dll
*.jam
*.JAM
*.c
*.h
*.blend
*.png
*.bmp
*.BMP
*.wav
*.pcm
*.PCM
*.tun
*.TUN
*.mp4
.DS_Store
.env
.env.*
*.pem
*.key
